{
  "name": "@sruthik/agentlink",
  "version": "0.3.0",
  "description": "Local-first coordination bus for coding agents working across repos through durable contracts.",
  "type": "module",
  "bin": {
    "agentlink": "dist/cli.js",
    "agentlink-mcp": "dist/mcp/server.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "release-notes-v0.2.0.md",
    "release-notes-v0.3.0.md",
    "docs/network-foundation.md",
    "scripts/verify-network-foundation.mjs",
    "scripts/verify-network-bridge.mjs",
    "demos/agentlink-demo.gif",
    "scripts/network-mcp-record.mjs",
    "docs/network-macbook-pilot.md",
    "docs/network-collaboration.md",
    "scripts/verify-network-native.mjs",
    "scripts/verify-network-installed.mjs",
    "scripts/verify-network-collaboration.mjs",
    "scripts/network-fixture.mjs",
    "demos/agentlink-demo.cast",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.js.map",
    "docs/network-wake.md",
    "docs/network-operations.md",
    "docs/setup.md",
    "docs/release-readiness.md",
    "docs/connect.md",
    "scripts/verify-connect-installed.mjs",
    "scripts/verify-setup-installed.mjs",
    "scripts/verify-network-wake.mjs",
    "scripts/verify-network-native-adapters.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/*.test.js dist/**/*.test.js",
    "verify:release": "node scripts/verify-release.mjs",
    "agentlink": "npm run build --silent && node dist/cli.js",
    "postbuild": "chmod +x dist/cli.js dist/mcp/server.js"
  },
  "keywords": [
    "claude-code",
    "agents",
    "mcp",
    "tmux",
    "multi-agent",
    "cross-repo"
  ],
  "author": "Sruthik Issac <sruthik2016@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sruthik27/agentlink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sruthik27/agentlink.git"
  },
  "bugs": {
    "url": "https://github.com/sruthik27/agentlink/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
