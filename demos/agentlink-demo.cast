[2.2,"o","Started conversation 9cdec4a0-6fc9-45e3-86f4-8ec7991b7b46: Add account summary endpoint\r\nMessage cap: 4\r\nRequired approvals: 2\r\nContract: /private/tmp/agentlink-demo/producer/.agentlink/CONTRACT.md\r\n"]
